{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      ".specify/**": "allow",
      "./.specify/**": "allow",
      "**/.specify/*": "allow",

      "bash .specify/*": "allow",
      "bash ./.specify/*": "allow",
      "bash */.specify/*": "allow",
      "sh .specify/*": "allow",
      "sh ./.specify/*": "allow",
      "sh */.specify/*": "allow",
      "/bin/bash .specify/*": "allow",
      "/bin/bash ./.specify/*": "allow",
      "/bin/bash */.specify/*": "allow",
      "/bin/sh .specify/*": "allow",
      "/bin/sh ./.specify/*": "allow",
      "/bin/sh */.specify/*": "allow",
      "source .specify/*": "allow",
      "source ./.specify/*": "allow",
      "source */.specify/*": "allow",
      ". .specify/*": "allow",
      ". ./.specify/*": "allow",
      ". */.specify/*": "allow",
      "python3 .specify/*": "allow",
      "python3 ./.specify/*": "allow",
      "python3 */.specify/*": "allow",
      "python .specify/*": "allow",
      "python ./.specify/*": "allow",
      "python */.specify/*": "allow",

      "git checkout -b*": "allow",
      "git checkout main*": "allow",
      "git pull origin main*": "allow",
      "git init*": "allow",
      "git submodule add*": "allow",
      "git submodule update*": "allow",
      "git rm --cached*": "allow",
      "git worktree remove*": "allow",
      "git -C * checkout -b*": "allow",
      "git -C * checkout main*": "allow",
      "git -C * pull origin main*": "allow",
      "git -C * init*": "allow",
      "git -C * submodule add*": "allow",
      "git -C * submodule update*": "allow",
      "git -C * rm --cached*": "allow",
      "git -C * worktree remove*": "allow",
      "git -C * add*": "allow",
      "git -C * commit*": "allow",

      "npm test*": "allow",
      "npm run test*": "allow",
      "npm run test:*": "allow",
      "npm run tests*": "allow",
      "npm run unit*": "allow",
      "npm run integration*": "allow",
      "npm run e2e*": "allow",
      "npm run coverage*": "allow",
      "npx jest*": "allow",
      "jest*": "allow",
      "npx vitest*": "allow",
      "vitest*": "allow",
      "npx mocha*": "allow",
      "mocha*": "allow",
      "npx ava*": "allow",
      "ava*": "allow",
      "npx cypress run*": "allow",
      "cypress run*": "allow",
      "npx playwright test*": "allow",
      "playwright test*": "allow",
      "npx tsx --test*": "allow",
      "npx karma start*": "allow",
      "yarn test*": "allow",
      "yarn run test*": "allow",
      "yarn test:*": "allow",
      "pnpm test*": "allow",
      "pnpm run test*": "allow",
      "pnpm test:*": "allow",
      "bun test*": "allow",
      "bun run test*": "allow",
      "deno test*": "allow",
      "node --test*": "allow",

      "pytest*": "allow",
      "py.test*": "allow",
      "python -m pytest*": "allow",
      "python3 -m pytest*": "allow",
      "python -m unittest*": "allow",
      "python3 -m unittest*": "allow",
      "tox*": "allow",
      "nox*": "allow",

      "go test*": "allow",

      "cargo test*": "allow",
      "cargo nextest*": "allow",

      "mvn test*": "allow",
      "./mvnw test*": "allow",
      "mvnw test*": "allow",
      "gradle test*": "allow",
      "./gradlew test*": "allow",
      "gradlew test*": "allow",

      "rspec*": "allow",
      "bundle exec rspec*": "allow",
      "rake test*": "allow",
      "make test*": "allow",
      "make check*": "allow",
      "ctest*": "allow",

      "phpunit*": "allow",
      "vendor/bin/phpunit*": "allow",
      "composer test*": "allow",
      "artisan test*": "allow",
      "dotnet test*": "allow",
      "mix test*": "allow",
      "flutter test*": "allow",
      "dart test*": "allow",
      "swift test*": "allow",
      "bazel test*": "allow",
      "terraform test*": "allow",
      "tofu test*": "allow"
    }
  }
}